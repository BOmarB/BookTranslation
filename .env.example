# VirusTotal (optional - pre-translate file scan)
VT_API_KEY=

# Azure Translator - primary provider (free F0: 2M chars/month, no auto-charge)
# Create at: https://portal.azure.com → "Translator" (multi-service AI resource)
AZURE_TRANSLATOR_KEY=
# Your resource region (e.g. eastus, westeurope) or "global"
AZURE_TRANSLATOR_REGION=global
